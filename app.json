{
  "expo": {
    "name": "BoxHockey",
    "slug": "BoxHockey",
    "version": "1.0.0",
    "scheme": "boxhockey",
    "description": "A digital BoxHockey game",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/f4670ecf-ee93-4812-bf48-d27b020a2510"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/images/icon-dark.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infinitetoken.BoxHockey",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "dark": "./assets/images/icon-dark.png",
        "light": "./assets/images/icon-light.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.infinitetoken.tastic"
        ]
      }
    },
    "android": {
      "package": "com.infinitetoken.boxhockey"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon-dark.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "imageWidth": 200,
          "backgroundColor": "#FAFAFA",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#050505"
          }
        }
      ],
      "expo-asset",
      "@tastic/edge-guard",
      "@tastic/core"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f4670ecf-ee93-4812-bf48-d27b020a2510"
      }
    },
    "owner": "jayrdeaton"
  }
}
