{
  "name": "box-hockey",
  "version": "1.0.0",
  "private": true,
  "description": "A digital BoxHockey game",
  "type": "commonjs",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build:development": "npm run verify && expo prebuild --clean && eas build --profile development --local",
    "build:preview": "npm run verify && eas build --profile preview",
    "build:production": "npm run verify && eas build --profile production",
    "client": "expo start --dev-client",
    "doctor": "expo install --fix && npx expo-doctor@latest",
    "fingerprint:compare": "eas fingerprint:compare",
    "fix": "expo lint . --fix",
    "postinstall": "setup-skia-web",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "lint": "expo lint .",
    "prebuild": "expo prebuild --clean",
    "reset": "expo start -c",
    "run": "eas build:run",
    "start": "expo start",
    "submit": "eas submit",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc",
    "update": "npm run verify && rific-bump-ota src/constants/release.ts && eas update",
    "update:development": "npm run update -- --branch development --environment development --message \"$(git log -1 --pretty=%B)\"",
    "update:preview": "npm run update -- --branch preview --environment preview --non-interactive --message \"$(git log -1 --pretty=%B)\"",
    "update:production": "npm run update -- --branch production --environment production --non-interactive --message \"$(git log -1 --pretty=%B)\"",
    "verify": "npm run lint && npm test && npm run typecheck"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rific/auto-paper": "^0.10.1",
    "@rific/feedback-press": "^0.10.5",
    "@rific/focus-chain": "^0.4.4",
    "@rific/splash-gate": "^0.2.0",
    "@rific/toaster": "^0.6.1",
    "@rific/updater": "^0.4.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tastic/animations": "^0.1.1",
    "@tastic/core": "^0.1.2",
    "@tastic/edge-guard": "^0.1.1",
    "@tastic/hud": "^0.2.0",
    "@tastic/input": "^0.1.2",
    "@tastic/physics": "^0.1.2",
    "@tastic/profile": "^0.3.6",
    "@tastic/split-screen": "^0.2.3",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-sensors": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@infinitetoken/eslint-config": "^0.2.0",
    "@infinitetoken/jest-config": "^0.2.4",
    "@infinitetoken/tsconfig": "^0.4.1",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
