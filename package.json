{
  "name": "box-hockey",
  "version": "1.1.0",
  "private": true,
  "description": "Physics-driven tabletop box hockey. Flick the puck through the gaps and into the other player's goal, against the CPU or a friend across the table.",
  "type": "commonjs",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "eas build",
    "build:web": "npm run verify && WEB_BASE_URL=/boxhockey expo export -p web --output-dir web-build/boxhockey",
    "client": "expo start --dev-client",
    "doctor": "expo install --fix && npx expo-doctor@latest",
    "fingerprint:compare": "eas fingerprint:compare",
    "fix": "expo lint . --fix",
    "postinstall": "setup-skia-web",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "lint": "expo lint .",
    "reset": "expo start -c",
    "run": "eas build:run",
    "start": "expo start",
    "submit": "eas submit",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc",
    "update": "eas update",
    "verify": "npm run lint && npm test && npm run typecheck"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@rific/auto-paper": "^0.13.3",
    "@rific/core": "^0.5.0",
    "@rific/feedback-press": "^0.13.1",
    "@rific/focus-chain": "^0.4.8",
    "@rific/gestures": "^0.1.3",
    "@rific/splash-gate": "^0.2.3",
    "@rific/toaster": "^0.10.0",
    "@rific/updater": "^0.7.1",
    "@shopify/react-native-skia": "2.14.0",
    "@tastic/achievements": "^0.6.0",
    "@tastic/core": "^0.14.0",
    "@tastic/edge-guard": "^0.1.5",
    "@tastic/hud": "^0.24.1",
    "@tastic/input": "^0.4.1",
    "@tastic/physics": "^0.3.1",
    "@tastic/profile": "^0.16.2",
    "@tastic/split-screen": "^0.5.4",
    "@tastic/sprites": "^0.2.1",
    "expo": "~58.0.11",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-blur": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.13",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.6",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.20",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.9",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@infinitetoken/eslint-config": "^0.2.0",
    "@infinitetoken/jest-config": "^0.5.2",
    "@infinitetoken/tsconfig": "^0.6.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
